# =============================================================================
# SonarValidator 환경변수 템플릿
# =============================================================================
# 사용법:
#   cp .env.example .env
#   (그리고 아래 값들을 필요에 맞게 수정)
#
# ⚠️ .env 는 git 에 커밋하지 않는다. (.gitignore 에 등록되어 있음)
# =============================================================================

# -----------------------------------------------------------------------------
# 베이스 이미지 태그
# -----------------------------------------------------------------------------
# JDK 26 베이스 이미지는 docker/base 에서 직접 굽는다.
#   docker compose --profile bootstrap build
BASE_IMAGE=sonar-validator/jdk26-base:26.0.2.1

# 애플리케이션 이미지 태그 (backend / frontend 공통)
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# 호스트 포트
# -----------------------------------------------------------------------------
# nginx(프론트)가 열리는 포트. 브라우저는 여기로 접속한다.
FRONTEND_PORT=80
# 백엔드 직접 노출 포트. C++ Prober 의 SERVER_PORT=3000 과 맞춘다.
BACKEND_PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# ⚠️ POSTGRES_* 는 "컨테이너를 처음 만들 때"만 적용된다.
#    값을 바꾸려면 `docker compose down -v` 로 볼륨을 지우고 다시 올려야 한다.
DB_NAME=sonarvalidator
DB_USER=sonarvalidator
DB_PASSWORD=sonarvalidator

# -----------------------------------------------------------------------------
# 초기 관리자 계정
# -----------------------------------------------------------------------------
# 아이디는 코드에 "admin" 으로 고정되어 있고, 비밀번호만 여기서 정한다.
# ⚠️ 사용자가 하나도 없을 때만 쓰인다. 이미 계정이 있으면 무시된다.
#    비밀번호를 바꾸려면 화면의 [계정 설정] → 비밀번호 변경을 쓰거나
#    `docker compose down -v` 로 DB 를 초기화해야 한다.
SONAR_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# OPNsense API Secret 암호화 키 (AES-256-GCM, 32바이트 Base64)
# -----------------------------------------------------------------------------
# 생성:  openssl rand -base64 32
# ⚠️ 비워 두면 임시 키가 생성되고, 재시작하면 기존 Secret 을 복호화하지 못한다.
SONAR_SECRET_KEY=J8lWHOlLEKevaytC8FJD0h1bihNVEAfh+4peCcNMjxY=

# -----------------------------------------------------------------------------
# CORS 허용 출처 (쉼표 구분)
# -----------------------------------------------------------------------------
# nginx 프록시를 쓰면 "같은 출처"가 되므로 필요 없다. 호스트에서 Vite 개발
# 서버를 띄워 붙일 때만 필요하다.
SONAR_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# -----------------------------------------------------------------------------
# 프론트 API 주소 (비워 두는 것을 권장)
# -----------------------------------------------------------------------------
# 빈 값 → 상대 경로로 호출 → nginx 가 backend:3000 으로 프록시 (CORS 없음)
# ⚠️ 값을 바꾸면 프론트 이미지를 "다시 빌드"해야 한다. (VITE_* 는 빌드 시 치환)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# JVM 옵션
# -----------------------------------------------------------------------------
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Seoul

# -----------------------------------------------------------------------------
# 빌드 시 테스트 실행 여부
# -----------------------------------------------------------------------------
# true  → 이미지 빌드에서 테스트를 건너뛴다 (빠름)
# false → mvn package 가 전체 테스트를 돌린다
SKIP_TESTS=true
