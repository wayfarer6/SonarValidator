{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prober: CMake configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}/SonarValidator_Prober",
        "-B",
        "${workspaceFolder}/SonarValidator_Prober/build-debug",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DANTLR4_RUNTIME_ROOT=${env:HOME}/tools/antlr4-install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Prober: Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/SonarValidator_Prober/build-debug",
        "--parallel",
        "4",
        "--target",
        "sonar_validator_prober"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Prober: CMake configure (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Prober: Build all tests (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/SonarValidator_Prober/build-debug",
        "--parallel",
        "4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Prober: CMake configure (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Prober: Run tests (Debug)",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/SonarValidator_Prober/build-debug",
        "--output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Prober: Build all tests (Debug)",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
