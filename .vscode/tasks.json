{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++-15 활성 파일 빌드",
            "command": "/usr/bin/g++-15",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++23",
                "-I${workspaceFolder}/SonarValidator_Prober",
                "${file}",
                "${workspaceFolder}/SonarValidator_Prober/prober_config.cpp",
                "${workspaceFolder}/SonarValidator_Prober/init.cpp",
                "${workspaceFolder}/SonarValidator_Prober/management_service.cpp",
                "${workspaceFolder}/SonarValidator_Prober/database/database_service.cpp",
                "${workspaceFolder}/SonarValidator_Prober/telemetry/telemetry_service.cpp",
                "${workspaceFolder}/SonarValidator_Prober/router/routing_table.cpp",
                "${workspaceFolder}/SonarValidator_Prober/switch/switch.cpp",
                "${workspaceFolder}/SonarValidator_Prober/firewall/firewall.cpp",
                "-o",
                "${workspaceFolder}/SonarValidator_Prober/output/sonar_validator_prober-debug",
                "-lsqlite3",
                "-lpthread",
                "-lssl",
                "-lcrypto"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "디버거에서 생성된 작업입니다."
        }
    ],
    "version": "2.0.0"
}