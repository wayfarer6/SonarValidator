set(version "4.13.2")
set(expected_sha256 "eae2dfa119a64327444672aff63e9ec35a20180dc5b8090b7a6ab85125df4d76")
if(NOT SONAR_ANTLR_TOOL_JAR)
    message(FATAL_ERROR "SONAR_ANTLR_TOOL_JAR is required")
endif()
if(EXISTS "${SONAR_ANTLR_TOOL_JAR}")
    file(SHA256 "${SONAR_ANTLR_TOOL_JAR}" actual_sha256)
    if(NOT actual_sha256 STREQUAL expected_sha256)
        message(FATAL_ERROR "Existing ANTLR tool has a different checksum; select a new SONAR_ANTLR_TOOL_JAR path")
    endif()
    message(STATUS "ANTLR ${version} tool already verified")
    return()
endif()
get_filename_component(parent "${SONAR_ANTLR_TOOL_JAR}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
file(DOWNLOAD "https://www.antlr.org/download/antlr-${version}-complete.jar"
    "${SONAR_ANTLR_TOOL_JAR}.download" EXPECTED_HASH "SHA256=${expected_sha256}"
    TLS_VERIFY ON TIMEOUT 60)
file(RENAME "${SONAR_ANTLR_TOOL_JAR}.download" "${SONAR_ANTLR_TOOL_JAR}")
message(STATUS "ANTLR ${version} tool downloaded and verified")
