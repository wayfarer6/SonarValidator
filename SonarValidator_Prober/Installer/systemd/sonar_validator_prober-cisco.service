[Unit]
Description=Sonar Validator Prober (Cisco guestshell)
# ⚠️ Cisco guestshell 의 네트워크는 IOS 호스트가 virtio 로 제공합니다.
#    network.target 은 컨테이너 안에서 systemd-networkd 를 끌어올 수 있어
#    의존하지 않습니다. 파일시스템만 준비되면 시작할 수 있습니다.
After=local-fs.target

[Service]
Type=simple
User=guestshell
WorkingDirectory=/home/guestshell
Environment=HOME=/home/guestshell
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/sonar_validator_prober
Restart=on-failure
RestartSec=3
# 프로세스는 SIGTERM 후 8초 예산 안에 스스로 종료합니다(main.cpp watchdog).
# systemd 는 그보다 여유를 두고, 그래도 남으면 SIGKILL 합니다.
TimeoutStopSec=15
KillMode=control-group
Environment=SONAR_CONFIG_PATH=/etc/sonar_validator_prober/default.conf
Environment=SONAR_TEMPLATE_PATH=/etc/sonar_validator_prober/sqlite_template.sqlite
Environment=SONAR_DATA_DIR=/var/lib/sonar_validator_prober

[Install]
WantedBy=multi-user.target
